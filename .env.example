# Local development settings for compose.yaml.
# Copy to .env and change the passwords: cp .env.example .env

# PostgreSQL container (first start only)
POSTGRES_DB=motorsport
POSTGRES_USER=pitwall
POSTGRES_PASSWORD=change-me

# Connection settings read by the API and the anomaly service
DB_PORT=5432
DB_NAME=motorsport
DB_USER=pitwall
DB_PASSWORD=change-me

# Host port for the API
API_PORT=8000
